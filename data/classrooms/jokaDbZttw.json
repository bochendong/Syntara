            {
              "id": "text_cwqEdLwy",
              "type": "text",
              "left": 60,
              "top": 150,
              "width": 880,
              "height": 330,
              "content": "<p style=\"font-size:18px\">• 使用具体函数进行黎曼和计算</p><p style=\"font-size:18px\">• 示例分析函数的单调性对黎曼和的影响</p><p style=\"font-size:18px\">• 讨论如何选择合适的分割</p><p style=\"font-size:18px\">• 计算 $int_0^4 \\sqrt{x} \\; dx$ 的左黎曼和</p><p style=\"font-size:18px\">• 近似面积为 $LHS = 2(\\sqrt{0} + \\sqrt{1} + \\sqrt{2} + \\sqrt{3})$</p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#333333",
              "rotate": 0
            },
