            },
            {
              "id": "text_x2OpLHYm",
              "type": "text",
              "left": 60,
              "top": 150,
              "width": 880,
              "height": 130,
              "content": "<p style=\"font-size:18px\">• 考虑速度变化时如何计算行驶距离</p><p style=\"font-size:18px\">• 使用测量速度的方法提高面积计算精度</p><p style=\"font-size:18px\">• 引导学生理解定积分的基本应用场景</p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#333333",
              "rotate": 0
            }
          ],
          "background": {
            "type": "solid",
